# ============================================================================
# Makefile.scanners
#
# Includable commands to your Makefiles
# All commands are namespaced under sec/ to avoid conflicts
# ============================================================================

__GHST_VERSION ?= main

# Where this file was loaded from, captured while Make is still reading it.
# MAKEFILE_LIST grows with every include, so lastword names this file here and
# something else later. Needed because the client's copy is fetched once and
# then never refetched -- the include rule has no prerequisites -- so the only
# way this file can tell a developer it has gone stale is to compare itself
# against what is published.
__GHST_SELF := $(lastword $(MAKEFILE_LIST))

# Image tag, which defaults to the makefile version but is separate on
# purpose: testing this makefile from a branch does not imply an image
# published under that branch's name. Set __GHST_IMAGE_TAG to point at a
# different image than the makefile came from.
__GHST_IMAGE_TAG ?= $(__GHST_VERSION)
__GHST_IMAGE ?= ghcr.io/avarko/gh-security-toolkit:$(__GHST_IMAGE_TAG)
__GHST_DOCKER_CMD ?= docker
__GHST_PLATFORM ?=

# Auto-detect host platform in a Docker-compatible format
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_M),x86_64)
  __GHST_PLATFORM ?= linux/amd64
else ifeq ($(UNAME_M),arm64)
  __GHST_PLATFORM ?= linux/arm64
else ifeq ($(UNAME_M),aarch64)
  __GHST_PLATFORM ?= linux/arm64
else
  # Fallback (safe) – try native but allow override
  __GHST_PLATFORM ?= linux/$(UNAME_M)
endif

# Docker options: Mount only current directory (read-only option available)
__GHST_MOUNT_RO ?= true

# Containers run as the invoking user so files they create in mounted
# directories stay owned by the developer, and so they can read a cache the
# developer owns. See the database section for why this is not optional.
__GHST_HOST_UID := $(shell id -u)
__GHST_HOST_GID := $(shell id -g)

# Docker socket GID for image scanning (auto-detected)
__DOCKER_SOCK_GID := $(shell stat -c '%g' /var/run/docker.sock 2>/dev/null || stat -f '%g' /var/run/docker.sock 2>/dev/null)

# ============================================================================
# Trivy vulnerability database cache
#
# The databases are no longer baked into the toolkit image: that cost ~2.8 GB
# of image and forced a full re-pull whenever they went stale. They now live in
# one cache directory shared by every project on this machine, updated
# incrementally — a developer who scanned recently fetches a delta of a few
# hundred kilobytes instead of ~1.4 GB.
#
# Scans still run air-gapped. Only sec/db/update touches the network, and only
# to fetch database updates.
# ============================================================================

__GHST_DB_CACHE ?= $(HOME)/.cache/gh-security-toolkit/trivy-db
__GHST_DB_REPO ?= ghcr.io/avarko/trivy-incremental-dbs

# Set GHST_OFFLINE=1 to skip the update check entirely and scan with whatever
# the cache already holds. Useful on a plane, behind a restrictive proxy, or
# when a scan must not depend on the network.
GHST_OFFLINE ?= 0

# Database artifacts are signed by the publishing workflow and verified before
# they are unpacked. A database that cannot be traced back to that workflow is
# not used: it decides what every scan reports, and a substituted one reports
# clean rather than looking wrong.
#
# Set to 0 only to update across the boundary where signing was introduced,
# since artifacts published before it carry no signature.
GHST_DB_REQUIRE_SIGNATURE ?= 1

# Refuse to scan against a database older than this many days. Stale
# vulnerability data is worse than a failed scan, because it reports "clean"
# for vulnerabilities published since.
__GHST_DB_MAX_AGE_DAYS ?= 14

# Set GHST_DB_DEBUG=1 to make the update trace itself: every registry command
# it runs, and crane's own HTTP request and response logs. Reach for it when
# an update fails for a reason the error does not name — a proxy that
# intercepts TLS, a blocked host, a token endpoint that answers differently
# than the pull does. The trace goes to stderr, so piping stdout still works.
GHST_DB_DEBUG ?= 0

# The cache is mounted read-only so a scan cannot corrupt it, but Trivy also
# wants somewhere writable for its own scratch state (fanal/, temp files). A
# tmpfs gives it that without a second host directory, and it is discarded
# when the container exits.
__GHST_DB_MOUNT := -v $(__GHST_DB_CACHE)/db:/opt/trivy-cache/db:ro \
	-v $(__GHST_DB_CACHE)/java-db:/opt/trivy-cache/java-db:ro \
	--tmpfs /opt/trivy-cache/fanal:rw,size=512m

# Mount Maven and Gradle caches if they exist
__M2_EXISTS        := $(shell [ -d "$$HOME/.m2/repository" ] && echo yes || echo no)
__GRADLE_EXISTS    := $(shell [ -d "$$HOME/.gradle/caches/modules-2" ] && echo yes || echo no)
__M2_MOUNT       := $(if $(filter yes,$(__M2_EXISTS)),-v $$HOME/.m2/repository:/home/ghst/.m2/repository:ro,)
__GRADLE_MOUNT   := $(if $(filter yes,$(__GRADLE_EXISTS)),-v $$HOME/.gradle/caches/modules-2:/home/ghst/.gradle/caches/modules-2:ro,)

# Scans run as the invoking user for the same reason the update does: the
# database cache is the developer's, and the image's own account cannot read
# it. Trivy also wants a writable HOME for its scratch state, which /tmp
# provides without touching the workspace.
__GHST_USER_OPTS := --user $(__GHST_HOST_UID):$(__GHST_HOST_GID) -e HOME=/tmp

# Network isolation: --network=none ensures air-gapped execution (no data leaves your machine)
ifeq ($(__GHST_MOUNT_RO),true)
	__GHST_DOCKER_OPTS := --rm --network=none $(__GHST_USER_OPTS) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	 -v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
else
	__GHST_DOCKER_OPTS := --rm --network=none $(__GHST_USER_OPTS) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v $(PWD):/workspace $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
endif

# Output format options
__GHST_TRIVY_FORMAT ?= table
__GHST_TRIVY_TIMEOUT ?= 5m

# ============================================================================
# Database management
# ============================================================================

# Database updates run inside the toolkit image, exactly like the scans do.
# Everything they need — the helper binary, crane, jq — ships in that image,
# so a developer installs nothing beyond Docker.
#
# Unlike the scan targets this one gets a network and a writable cache mount,
# because fetching updates is the one step that has to reach the registry.
#
# It also runs as the invoking user rather than the image's own account.
#
# Writing goes through the bind mount, but a bind mount is not a copy: it is
# the host's own directory, and the host kernel checks permissions against the
# host inode. The image's ghst account is uid 10001 while the cache belongs to
# the developer, so creating files there is denied — and were the directory
# world-writable it would be worse, since the files would end up owned by
# 10001 and `sec/db/clean` could not remove them without sudo.
#
# Docker Desktop on macOS remaps ownership and hides this; Linux does not.
__GHST_DB_RUN = $(__GHST_DOCKER_CMD) run --rm \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	--user $(__GHST_HOST_UID):$(__GHST_HOST_GID) \
	-v $(__GHST_DB_CACHE):/db-cache \
	-e GHST_DB_CACHE=/db-cache \
	-e HOME=/tmp \
	-e GHST_DB_REPO=$(__GHST_DB_REPO) \
	-e GHST_DB_MAX_AGE_DAYS=$(__GHST_DB_MAX_AGE_DAYS) \
	-e GHST_DB_REQUIRE_SIGNATURE=$(GHST_DB_REQUIRE_SIGNATURE) \
	-e GHST_OFFLINE=$(GHST_OFFLINE) \
	-e GHST_DB_DEBUG=$(GHST_DB_DEBUG) \
	-e GHST_VEX_SERVE=0 \
	$(__GHST_IMAGE) trivy-db-helper

# The cache directory must exist before Docker mounts it, or Docker creates it
# owned by root.
__GHST_DB_PREPARE = mkdir -p $(__GHST_DB_CACHE)

.PHONY: sec/db/update
sec/db/update: __ghst-image-ensure # Fetch Trivy database updates (incremental when possible)
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command update

.PHONY: sec/db/status
sec/db/status: __ghst-image-ensure # Show Trivy database cache location, age and versions
	@$(__GHST_DB_PREPARE)
	@echo "Trivy database cache: $(__GHST_DB_CACHE)"
	@# The helper reports the path it sees inside the container, which is not
	@# where the developer would go looking; the host path is printed above.
	@$(__GHST_DB_RUN) -command status | grep -v '^Trivy database cache:'

.PHONY: sec/db/clean
sec/db/clean: # Remove the cached Trivy databases
	@echo "🧹 Removing Trivy database cache..."
	@rm -rf $(__GHST_DB_CACHE)
	@echo "✅ Cache removed. The next scan downloads a fresh database."

# Scan targets depend on this: it updates a stale cache and is a no-op when the
# cache is current. GHST_OFFLINE=1 turns it into a freshness warning instead.
.PHONY: __ghst-db-ensure
__ghst-db-ensure: __ghst-image-ensure
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command ensure

# ============================================================================
# Toolkit image freshness
#
# Docker only pulls a tag when it has nothing local by that name, so an image
# pulled once is never revisited — a fixed bug or a new helper version sits in
# the registry indefinitely while every scan keeps running the old one. That
# is exactly how a database-format change once shipped to the registry days
# before any developer's local image could read it.
#
# Checked once per __GHST_IMAGE_MAX_AGE_DAYS rather than every invocation, so
# an otherwise offline scan does not pay a registry round-trip each time. Same
# shape as __GHST_DB_MAX_AGE_DAYS above, and for the same reason: a stale tool
# should be refreshed on a schedule, not left to a developer noticing.
#
# The stamp records what the check found, not just that it happened. `docker
# pull` already answers the question a developer actually has -- am I running
# the newest scanner -- and it was being thrown away by `-q` and a redirect to
# /dev/null. Without it the banner's publication date reads identically whether
# it was confirmed newest twenty minutes ago or last looked at on Wednesday.
#
# Three verdicts, and "unreachable" is the one worth having: it also stamps the
# file, so the next scan will not retry for a day. That is deliberate -- a
# developer on a train should not wait for a registry timeout before every scan
# -- but it means the image can be arbitrarily old with nothing having failed,
# which is only defensible now that the banner says so.
#
# What the stamp says is what decides whether to skip, not that it exists. A
# scan interrupted between the truncation and the write leaves an empty file,
# and on mere existence that would suppress the check for a day while the
# banner reported the freshness it had just been stopped from learning.
# ============================================================================

__GHST_IMAGE_MAX_AGE_DAYS ?= 1
__GHST_IMAGE_STAMP := $(HOME)/.cache/gh-security-toolkit/.image-checked-$(subst /,_,$(__GHST_IMAGE_TAG))

# The registry answering at all is the confirmation, whether it handed over a
# new image or said the cached one is still newest. Only "unreachable" leaves
# this untouched, which is what the floor measures -- and, as with the Makefile
# stamp beside it, the floor creates this one on first sight so a machine with
# nothing yet confirmed starts a clock rather than failing.
__GHST_IMAGE_CONFIRMED := $(HOME)/.cache/gh-security-toolkit/.image-confirmed-$(subst /,_,$(__GHST_IMAGE_TAG))

.PHONY: __ghst-image-ensure
__ghst-image-ensure:
	@mkdir -p "$(dir $(__GHST_IMAGE_STAMP))"
	@if [ "$(GHST_OFFLINE)" = "1" ]; then exit 0; fi; \
	verdict=$$(cat "$(__GHST_IMAGE_STAMP)" 2>/dev/null); \
	case "$$verdict" in current|updated|unreachable) ;; *) verdict="" ;; esac; \
	if [ -n "$$verdict" ] \
	   && $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) >/dev/null 2>&1; then \
		now=$$(date +%s); \
		checked=$$(stat -c %Y "$(__GHST_IMAGE_STAMP)" 2>/dev/null || stat -f %m "$(__GHST_IMAGE_STAMP)"); \
		age_days=$$(( (now - checked) / 86400 )); \
		[ "$$age_days" -lt "$(__GHST_IMAGE_MAX_AGE_DAYS)" ] && exit 0; \
	fi; \
	echo "🔄 Checking for a newer $(__GHST_IMAGE)..."; \
	before=$$($(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) --format '{{.Id}}' 2>/dev/null || true); \
	if out=$$($(__GHST_DOCKER_CMD) pull $(__GHST_IMAGE) 2>&1); then \
		touch "$(__GHST_IMAGE_CONFIRMED)"; \
		case "$$out" in \
			*"Image is up to date"*) echo current > "$(__GHST_IMAGE_STAMP)" ;; \
			*)                       echo updated > "$(__GHST_IMAGE_STAMP)" ;; \
		esac; \
		after=$$($(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) --format '{{.Id}}' 2>/dev/null || true); \
		if [ -n "$$before" ] && [ -n "$$after" ] && [ "$$before" != "$$after" ]; then \
			if [ "$$($(__GHST_DOCKER_CMD) image inspect "$$before" --format '{{len .RepoTags}}' 2>/dev/null || echo 1)" = "0" ]; then \
				$(__GHST_DOCKER_CMD) rmi "$$before" >/dev/null 2>&1 \
					&& echo "🧹 Removed the image this one replaced." \
					|| true; \
			fi; \
		fi; \
	elif $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) >/dev/null 2>&1; then \
		echo "⚠️  Could not reach the registry — using the cached image."; \
		echo unreachable > "$(__GHST_IMAGE_STAMP)"; \
	else \
		echo "❌ $(__GHST_IMAGE) is not available locally and the registry could not be reached."; \
		exit 1; \
	fi

# ============================================================================
# Makefile freshness
#
# The image and the database refresh themselves. This file used to be the one
# gap in "run the scan and you are current": the client's include rule fetches
# Makefile.scanners once into .gh-security-toolkit/ and has no prerequisites,
# so Make never rebuilt it. A developer who set this up in March was still
# running March's scan commands, and moving the v1 tag did nothing for them --
# a moved tag only reaches a machine that fetches again. Closing it is what
# stops a release needing an email asking everybody to delete a directory.
#
# It closes in two halves. This half decides whether a newer file exists, and
# has to ask about content rather than versions: pinning to a moving tag like
# v1 or main means the version string is identical on both sides while the
# file behind it has changed. The other half, further down, turns that answer
# into a re-fetch without this file ever overwriting itself -- which would be
# a thing to do to somebody's repository behind their back.
#
# One 30 kB fetch a day, no token, no registry. Skipped entirely when offline,
# where the honest answer is that nobody asked.
# ============================================================================

__GHST_SELF_MAX_AGE_DAYS ?= 1
__GHST_SELF_URL ?= https://raw.githubusercontent.com/Avarko/gh-security-toolkit/$(__GHST_VERSION)/Makefile.scanners
__GHST_SELF_STAMP := $(HOME)/.cache/gh-security-toolkit/.makefile-checked-$(subst /,_,$(__GHST_VERSION))

# Touched when a check confirms this file is the published one, and once more
# by the floor itself if the stamp does not exist yet. The floor measures from
# it, so it has to mean "confirmed", never "attempted" -- but a machine that
# has never confirmed anything has nothing to measure from either, and
# refusing on day one because the first check happened to fail is not the
# behaviour anybody wants. The bootstrap touch is where the clock starts on
# such a machine, and it reads as "confirmed" only in the sense that nothing
# has yet had the chance to be otherwise.
__GHST_SELF_CONFIRMED := $(HOME)/.cache/gh-security-toolkit/.makefile-confirmed-$(subst /,_,$(__GHST_VERSION))

# Touched only when a check finds a newer published file, which is what makes
# the include below out of date and gets it re-fetched.
__GHST_SELF_TRIGGER := $(HOME)/.cache/gh-security-toolkit/.makefile-outdated-$(subst /,_,$(__GHST_VERSION))

# Compared with cmp rather than by hashing. The two files are both on this
# disk by the time the question is asked, so a digest buys nothing, and it cost
# a portability split: sha256sum is GNU, shasum is what macOS ships, and the
# absence of both had to mean something. cmp is one name on every system this
# runs on.
#
# Whether the remote side was read at all is still decided from curl's exit
# status, never from the comparison. A failed fetch leaves an empty file, and
# an empty file compares unequal to this one -- which would tell a developer
# behind a captive portal that their scan commands are not the published ones.
# That is the false alarm this whole section exists to avoid.
#
# The once-a-day gate does not apply to a "stale" verdict, which is the one
# state that resolves itself: the re-fetch is already pending, and checking
# again is how the verdict becomes "current" once it lands. Backdating the
# stamp was the first way of arranging that, and it made the banner report the
# backdate as fact -- "checked 20701 days ago", which is 1970 rendered as news.

.PHONY: __ghst-self-check
__ghst-self-check:
	@if [ "$(GHST_OFFLINE)" = "1" ]; then exit 0; fi; \
	mkdir -p "$(dir $(__GHST_SELF_STAMP))"; \
	verdict=$$(cat "$(__GHST_SELF_STAMP)" 2>/dev/null); \
	case "$$verdict" in current|stale|unknown|unsupported) ;; *) verdict="" ;; esac; \
	if [ -n "$$verdict" ] && [ "$$verdict" != "stale" ]; then \
		now=$$(date +%s); \
		checked=$$(stat -c %Y "$(__GHST_SELF_STAMP)" 2>/dev/null || stat -f %m "$(__GHST_SELF_STAMP)"); \
		[ $$(( (now - checked) / 86400 )) -lt "$(__GHST_SELF_MAX_AGE_DAYS)" ] && exit 0; \
	fi; \
	if ! command -v cmp >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 \
	   || [ ! -r "$(__GHST_SELF)" ]; then \
		echo unsupported > "$(__GHST_SELF_STAMP)"; \
		exit 0; \
	fi; \
	reached=""; \
	body=$$(mktemp); \
	curl -fsSL --max-time 10 "$(__GHST_SELF_URL)" -o "$$body" 2>/dev/null && reached=yes; \
	if [ -z "$$reached" ]; then \
		rm -f "$$body"; \
		echo unknown > "$(__GHST_SELF_STAMP)"; \
	elif cmp -s "$(__GHST_SELF)" "$$body"; then \
		rm -f "$$body"; \
		echo current > "$(__GHST_SELF_STAMP)"; \
		touch "$(__GHST_SELF_CONFIRMED)"; \
	else \
		rm -f "$$body"; \
		echo stale > "$(__GHST_SELF_STAMP)"; \
		touch "$(__GHST_SELF_TRIGGER)"; \
	fi

# The re-fetch itself, and the whole reason the trigger is a file rather than
# a phony target.
#
# GNU Make re-reads an included makefile before it runs anything, and restarts
# the build if it changed. Naming the trigger as a prerequisite here is enough
# to get that: the consumer's own rule, the one their Makefile already has,
# does the fetching, so this reaches a colleague who set the toolkit up months
# ago without them editing anything. No recipe is given on purpose -- theirs
# stays in charge, and a repository whose include is spelled differently
# simply gets no rule and no re-fetch rather than an error.
#
# The trigger must be a real file with no prerequisites of its own. A phony in
# this chain makes the include permanently out of date: Make re-fetches it,
# restarts, finds it out of date again, and does that until it is killed --
# measured at four and a half thousand fetches before the loop was stopped.
# Created stamped 1970 so an install that has never been checked is not
# instantly considered stale.
#
# The prerequisite is declared conditionally, and it has to be: makefile
# remaking happens before any recipe runs, so a GHST_OFFLINE=1 check inside one
# is too late to stop it. An online run that found an update leaves the trigger
# newer than the include, and the next run re-fetches on that basis whether or
# not it has a network. Measured on an air-gapped machine with the README's own
# fetch rule, that is not a slow scan but no scan at all -- "Could not fetch",
# exit 2, before anything starts -- and it repeats on every invocation, because
# nothing offline can move the trigger back. An air-gapped machine that once
# saw a newer toolkit could never scan again.
#
# GHST_OFFLINE is available while Make is still parsing, from the environment
# or the command line alike, so declaring nothing here is enough: with no
# prerequisite the include is never out of date, and offline goes back to
# meaning that nobody asked.
ifneq ($(GHST_OFFLINE),1)
$(__GHST_SELF): $(__GHST_SELF_TRIGGER)
endif

$(__GHST_SELF_TRIGGER):
	@mkdir -p "$(dir $@)"
	@touch -t 197001020000 "$@"

# ============================================================================
# The freshness floor
#
# Everything above is best-effort: it heals a stale toolkit on the next scan
# and says so on this one. This is what happens when it does not work -- the
# self-update never fires because a repository spells its include differently,
# or a laptop spends a month off the network. Warnings are the wrong tool for
# that, because a warning printed on every scan is one people stop reading,
# and the failure it describes is silent: scanning with a toolkit from March
# reports clean for everything published since.
#
# So it refuses, on the same reasoning and the same default as
# __GHST_DB_MAX_AGE_DAYS: stale data fails rather than passes. GHST_OFFLINE=1
# is the way out, and is meant to be -- an air-gapped machine is not a broken
# one, and saying so out loud is cheaper than every developer discovering the
# escape hatch by reading the source.
#
# Measured from the last confirmation, never from the last attempt. A first
# install has nothing confirmed yet and starts its clock now, so a flaky
# network on day one does not refuse a scan that has never had the chance to
# be current.
#
# A host that cannot run the comparison at all is exempted from the Makefile
# half rather than refused by it. "We asked and got no answer" and "we have no
# way to ask" both used to be recorded as unknown, and collapsing them here
# would have meant telling somebody to fix a network that was never the
# problem -- fourteen days after the fact, with no way to act on the advice.
# The image half still applies to them, because a docker pull needs neither.
# ============================================================================

__GHST_MAX_STALE_DAYS ?= 14

# Two halves rather than one, because they guard different things at different
# prices. Semgrep runs out of its own image and never touches the scanner
# image, so making a Semgrep scan wait on a docker pull it has no use for --
# or refusing it because that pull has not happened -- would be a toll and not
# a safeguard. It does depend on this file being current, because the command
# line it runs is written here, so it takes the Makefile half.
#
# Make stops at the first prerequisite that fails, so a machine stale in both
# respects is told about one, fixes it, and is then told about the other.
# Listing both at once was the earlier shape and cost the split; being told
# the truth twice is better than being told half of it in one go.
#
# The remedy is a parameter rather than a sentence in the body, because the
# body is shared and the two halves are fixed differently. Written once into
# the body it told somebody whose scanner image had gone stale to delete a
# Makefile, which does nothing for a stale image.
#
# $(1) confirmation stamp   $(2) what to call it   $(3) verdict stamp, if any
# $(4) how to fix it by hand
define __ghst-floor-check
if [ "$(GHST_OFFLINE)" = "1" ]; then exit 0; fi; \
mkdir -p "$(dir $(1))"; \
if [ -n "$(3)" ] && [ "$$(cat "$(3)" 2>/dev/null)" = "unsupported" ]; then \
	echo "⚠️  This host has no cmp or no curl, so $(__GHST_SELF) cannot be compared with the published one. Its age is reported but not enforced." >&2; \
	exit 0; \
fi; \
if [ ! -e "$(1)" ]; then touch "$(1)"; exit 0; fi; \
age=$$(( ( $$(date +%s) - $$(stat -c %Y "$(1)" 2>/dev/null || stat -f %m "$(1)" 2>/dev/null || echo 0) ) / 86400 )); \
if [ "$$age" -lt "$(__GHST_MAX_STALE_DAYS)" ]; then exit 0; fi; \
echo "❌ Refusing to scan: nothing has confirmed $(2) for $$age days." >&2; \
echo "   A scan against a stale toolkit reports clean for everything published since." >&2; \
echo "   Fix the network and re-run, or $(4)." >&2; \
echo "   On a machine that is meant to be air-gapped, set GHST_OFFLINE=1." >&2; \
exit 1
endef

.PHONY: __ghst-floor-makefile
__ghst-floor-makefile: __ghst-self-check
	@$(call __ghst-floor-check,$(__GHST_SELF_CONFIRMED),this toolkit Makefile,$(__GHST_SELF_STAMP),delete $(__GHST_SELF) and run make again)

.PHONY: __ghst-floor-image
__ghst-floor-image: __ghst-image-ensure
	@$(call __ghst-floor-check,$(__GHST_IMAGE_CONFIRMED),the scanner image,,run 'make sec/scan/clean' to drop the cached image)

.PHONY: __ghst-freshness-floor
__ghst-freshness-floor: __ghst-floor-makefile __ghst-floor-image

# ============================================================================
# Provenance
#
# Every scan states what produced it, naming both sources by their repository:
# the scanner image from gh-security-toolkit, and the vulnerability data from
# trivy-incremental-dbs. Each line carries a publication date as well as a
# digest or version, because a date is what a reader can judge at a glance and
# a hash is what they need when they have to reproduce the run.
#
# This exists because a scan result is only worth something if it can be
# reproduced, and until now nothing in the output said what it ran. A tag is
# not an answer: `main` moved twice this week, and two developers scanning the
# same code on the same day could get different findings with no way to tell.
#
# The image half is read from the local image, so it costs nothing and works
# offline. The database half asks the helper inside that image, which is one
# short container run against a cache that is already mounted. Asking the
# helper rather than parsing the cache directly means this works with the
# helper that is published today, not only with one built after this change.
#
# Output goes to stderr, so it cannot land in a report redirected to a file.
# Note that the scan targets' own progress echoes still go to stdout, so
# `__GHST_TRIVY_FORMAT=json > report.json` is not clean today for reasons that
# predate this banner.
# ============================================================================

# Docker's template language has no "or" for missing map keys, so each value
# is fetched with `with`, which prints nothing when the label is absent.
__GHST_LABEL = $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) \
	--format '{{with index .Config.Labels "$(1)"}}{{.}}{{end}}' 2>/dev/null

.PHONY: sec/provenance
sec/provenance: ## Print what a scan on this machine would run: images, dates, digests, versions
	@$(MAKE) --no-print-directory __ghst-provenance GHST_PROVENANCE_VERBOSE=1

# Printed before every Trivy scan. Silent about anything it cannot determine
# rather than guessing: "unknown" is better than a plausible wrong answer.
#
# That rule was broken in the one place it mattered. Asking the helper for the
# database version discarded its stderr and ignored its exit status, so a
# container that would not start -- no image, no daemon, a helper that crashed
# -- came out as "no database cached": a factual claim about the cache, made by
# code that had not managed to look at it. A developer reads that as an empty
# cache and reruns the scan, which is the one response that cannot help. The
# failure now says it is a failure and shows what the helper said.
#
# Verbose also names cosign and crane, not only the scanners. They are how the
# database got here and how its signature was checked, so "the database was
# verified" means exactly as much as the cosign version behind it.
.PHONY: __ghst-provenance
# The floor is a prerequisite rather than a step inside the banner, so the
# ordering holds under -j: the checks it reads have finished before it reads
# them. It refuses without printing the banner first, which is the right way
# round -- the refusal names the artefact and its age itself, and a banner
# describing a scan that is not going to happen is noise.
__ghst-provenance: __ghst-db-ensure __ghst-self-check __ghst-freshness-floor
	@stamp_age() { \
		s=$$(stat -c %Y "$$1" 2>/dev/null || stat -f %m "$$1" 2>/dev/null); \
		[ -n "$$s" ] || { echo "never"; return; }; \
		d=$$(( $$(date +%s) - s )); \
		if [ "$$d" -lt 3600 ]; then echo "$$(( d / 60 )) min ago"; \
		elif [ "$$d" -lt 172800 ]; then echo "$$(( d / 3600 )) h ago"; \
		else echo "$$(( d / 86400 )) days ago"; fi; \
	}; \
	if [ "$(GHST_OFFLINE)" = "1" ]; then \
		fresh="not checked, GHST_OFFLINE=1"; \
	else \
		case "$$(cat "$(__GHST_IMAGE_STAMP)" 2>/dev/null)" in \
			current|updated) fresh="newest as of $$(stamp_age "$(__GHST_IMAGE_STAMP)")" ;; \
			unreachable)     fresh="registry unreachable $$(stamp_age "$(__GHST_IMAGE_STAMP)")" ;; \
			*)               fresh="freshness unknown" ;; \
		esac; \
	fi; \
	selfverdict=$$(cat "$(__GHST_SELF_STAMP)" 2>/dev/null); \
	case "$$selfverdict" in current|stale|unknown|unsupported) ;; *) selfverdict="" ;; esac; \
	if [ -n "$$selfverdict" ]; then \
		selfstate="$$selfverdict as of $$(stamp_age "$(__GHST_SELF_STAMP)")"; \
	elif [ "$(GHST_OFFLINE)" = "1" ]; then \
		selfstate="not checked, GHST_OFFLINE=1"; \
	else \
		selfstate="not checked"; \
	fi; \
	ref='$(__GHST_IMAGE)'; \
	if ! $(__GHST_DOCKER_CMD) image inspect $$ref >/dev/null 2>&1; then \
		echo "==> gh-security-toolkit: $$ref is not present locally yet" >&2; \
	else \
		digest=$$($(__GHST_DOCKER_CMD) image inspect $$ref \
			--format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' 2>/dev/null \
			| sed 's/.*@//'); \
		revision=$$($(call __GHST_LABEL,org.opencontainers.image.revision)); \
		built=$$($(call __GHST_LABEL,org.opencontainers.image.created)); \
		if [ -z "$$built" ]; then \
			built=$$($(__GHST_DOCKER_CMD) image inspect $$ref --format '{{.Created}}' 2>/dev/null); \
		fi; \
		built=$$(echo "$$built" | cut -c1-10); \
		echo "==> gh-security-toolkit: image '$(__GHST_IMAGE_TAG)' published $${built:-unknown} ($$fresh), digest $$(echo $${digest:-unknown} | cut -c1-19), revision $$(echo $${revision:-unknown} | cut -c1-12)" >&2; \
		if [ "$(GHST_PROVENANCE_VERBOSE)" = "1" ]; then \
			trivy_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trivy.version)); \
			th_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trufflehog.version)); \
			cosign_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.cosign.version)); \
			crane_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.crane.version)); \
			helper_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trivy-db-helper.version)); \
			echo "    digest      $${digest:-unknown}" >&2; \
			echo "    revision    $${revision:-unknown}" >&2; \
			echo "    trivy       $${trivy_ver:-unknown}" >&2; \
			echo "    trufflehog  $${th_ver:-unknown}" >&2; \
			echo "    cosign      $${cosign_ver:-unknown}" >&2; \
			echo "    crane       $${crane_ver:-unknown}" >&2; \
			echo "    db helper   $${helper_ver:-unknown}" >&2; \
			echo "    makefile    taken from '$(__GHST_VERSION)', image tag '$(__GHST_IMAGE_TAG)'" >&2; \
			echo "    self-check  $$selfstate, $(__GHST_SELF)" >&2; \
		fi; \
		if [ -z "$$digest" ]; then \
			echo "    note: no registry digest. This image was built or loaded locally, so no" >&2; \
			echo "          published image corresponds to this scan." >&2; \
		fi; \
		if [ -z "$$revision" ]; then \
			echo "    note: no revision label, so the commit behind this scan is unknown." >&2; \
			echo "          Pull the image again once a labelled one is published." >&2; \
		fi; \
	fi; \
	$(__GHST_DB_PREPARE); \
	dberr=$$(mktemp); \
	if status=$$($(__GHST_DB_RUN) -command status 2>"$$dberr"); then \
		echo "==> trivy-incremental-dbs: $$(echo "$$status" | $(__GHST_AWK_DB_VERSIONS))" >&2; \
		if [ "$(GHST_PROVENANCE_VERBOSE)" = "1" ]; then \
			echo "$$status" | sed 's/^/    /' >&2; \
		fi; \
	else \
		echo "==> trivy-incremental-dbs: could not be asked, so the database behind this scan is unknown" >&2; \
		sed 's/^/    /' "$$dberr" >&2; \
	fi; \
	rm -f "$$dberr"; \
	if [ "$(__GHST_VERSION)" != "$(__GHST_IMAGE_TAG)" ]; then \
		echo "    note: Makefile pinned to '$(__GHST_VERSION)', image tag '$(__GHST_IMAGE_TAG)'." >&2; \
		echo "          Pinning the include does not pin the scanner." >&2; \
	fi; \
	if [ "$$selfverdict" = "stale" ]; then \
		echo "    note: these scan commands are not the ones published at '$(__GHST_VERSION)'" >&2; \
		echo "          (checked $$(stamp_age "$(__GHST_SELF_STAMP)")). The next run with a" >&2; \
		echo "          network re-fetches this file and restarts with it." >&2; \
	fi

# Reduces the helper's status report to one line: each database with the date
# it was published, whether it is the newest published, and which helper
# assembled it.
#
# The version each database carries is a publication date in YYYYMMDD form,
# which is why it can be rendered as one. Anything the helper did not report
# comes out as "unknown" rather than being dropped, so a partial line cannot
# read as a complete one.
#
# "checked:" is preferred over "age:" and "age:" is kept as the fallback,
# because the two sides ship separately: this file arrives by curl and the
# helper inside whatever scanner image is pulled, so a Makefile updated today
# routinely runs against a helper that predates the line. Falling back keeps
# that pairing reporting what it always did instead of "fetched ? day(s) ago".
__GHST_AWK_DB_VERSIONS = awk ' \
	/^  (main|java):/ { \
		name = $$1; sub(":", "", name); \
		v = $$2; \
		if (v ~ /^[0-9]{8}$$/) \
			v = substr(v,1,4) "-" substr(v,5,2) "-" substr(v,7,2); \
		out = out (out ? ", " : "") name " " v; \
	} \
	/^  age:/     { age = $$2 } \
	/^  checked:/ { sub(/^  checked: */, ""); checked = $$0 } \
	/^  helper:/  { helper = $$3 } \
	END { \
		printf "%s", (out ? out : "no database cached"); \
		if (checked) \
			printf ", %s", checked; \
		else \
			printf ", fetched %s day(s) ago", (age == "" ? "?" : age); \
		printf ", helper %s", (helper ? helper : "unknown"); \
	}'

# ============================================================================
# Trivy - Automatically uses .trivy.yaml if present
#
# Scans run with --network=none against a database mounted from the host
# cache, so no scan reaches the network. Only sec/db/update does.
#
# Gradle note: trivy fs . only works with lock files. For Gradle projects:
#   Option A: Generate lock files first:  ./gradlew dependencies --write-locks
#   Option B: Scan built artifacts:       make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war
# ============================================================================

.PHONY: sec/scan/trivy/fs
sec/scan/trivy/fs: __ghst-provenance # Scan filesystem (uses .trivy.yaml config)
	@echo "🔍 Scanning filesystem with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/artifact
sec/scan/trivy/artifact: __ghst-provenance # Scan built artifact - Gradle WAR/JAR/EAR (ARTIFACT=path/to/app.war)
	@[ -n "$(ARTIFACT)" ] || (echo "❌ Usage: make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war" && exit 1)
	@[ -e "$(ARTIFACT)" ] || (echo "❌ Artifact not found: $(ARTIFACT)" && exit 1)
	@echo "🔍 Scanning artifact $(ARTIFACT) with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs $(ARTIFACT) --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/config
sec/scan/trivy/config: __ghst-provenance # Scan IaC configs for misconfigurations - Terraform, Dockerfile, K8s, etc. (uses .trivy.yaml config)
	@echo "🔍 Scanning IaC configs with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy config . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/img
sec/scan/trivy/img: __ghst-provenance # Scan Docker image (IMAGE=name:tag)
	@[ -n "$(IMAGE)" ] || (echo "❌ Usage: make sec/scan/trivy/img IMAGE=name:tag" && exit 1)
	@echo "🔍 Scanning image $(IMAGE) (offline mode)..."
	@echo "ℹ️  Note: this target mounts the Docker socket so Trivy can read the"
	@echo "   image. That is root-equivalent access to this host, and this is the"
	@echo "   only target that needs it. The scan itself still runs with"
	@echo "   --network=none, like every other scan."
	$(__GHST_DOCKER_CMD) run --rm --network=none \
	$(if $(__DOCKER_SOCK_GID),--group-add $(__DOCKER_SOCK_GID),) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) -w /workspace \
	$(__GHST_IMAGE) trivy image $(IMAGE) --format $(__GHST_TRIVY_FORMAT)

# ============================================================================
# Semgrep - uses .semgrep.yaml or .semgrep.yml if present
#
# The one scanner here that needs the network while it runs, which is worth
# stating plainly because every other one is emphatic about not having it. The
# p/ rulesets are fetched from semgrep.dev on each scan: under --network=none
# Semgrep does not degrade, it dies -- a requests ConnectionError traceback and
# exit 2. So GHST_OFFLINE=1 skips this target rather than leaving it to crash,
# and "air-gapped" in this toolkit means the Trivy scans.
#
# A repository with its own .semgrep.yaml can be scanned without the registry,
# unless that file pulls p/ rules of its own. Nothing here assumes either way.
# ============================================================================

# Pinned to an exact version and digest, for the reason every action here is
# pinned to a SHA: a tag moves and nothing ships. It was "latest" before, which
# combined badly with nothing ever pulling it -- Docker kept whatever it had
# first cached, indefinitely, so two developers could get different findings
# from the same commit and neither could tell.
#
# actions/scanner/semgrep installs this same version with pip, so a local scan
# and a CI scan run the same Semgrep. scripts/check-semgrep-config.py fails the
# build if the two drift apart. Bumping means moving both, plus the digest:
#   docker buildx imagetools inspect semgrep/semgrep:<version> --format '{{.Manifest.Digest}}'
SEMGREP_VERSION ?= 1.176.1
SEMGREP_DIGEST ?= sha256:34ab619bf1391a24bfda3f05debd0d8a6ce3093c2d5f9d39cfc00f83c1397823
SEMGREP_IMAGE ?= semgrep/semgrep:$(SEMGREP_VERSION)@$(SEMGREP_DIGEST)

# The same rulesets CI runs. They were different lists in three files, so a
# local scan and a CI scan disagreed about what they had checked -- this one is
# the union of what each used to have. check-semgrep-config.py keeps the three
# in step.
SEMGREP_CONFIGS ?= p/owasp-top-ten p/cwe-top-25 p/java p/javascript p/docker-compose p/dockerfile p/terraform p/secrets

# Run as the invoking user, like every Trivy scan, rather than as root because
# the image happens to default to it. HOME is set for the same reason it is
# there: Semgrep wants somewhere writable for its own scratch state, and the
# workspace is mounted read-only.
SEMGREP_DOCKER_OPTS := --rm $(__GHST_USER_OPTS) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v $(PWD):/src:ro -w /src

.PHONY: sec/scan/semgrep
sec/scan/semgrep: __ghst-floor-makefile # Scan code with Semgrep (uses .semgrep.yaml config)
	@if [ "$(GHST_OFFLINE)" = "1" ]; then \
		echo "⏭️  Skipping Semgrep: its rulesets are fetched from semgrep.dev and GHST_OFFLINE=1."; \
		echo "   The Trivy scans do run air-gapped; this one has nothing to run without a network."; \
		exit 0; \
	fi; \
	echo "🔍 Scanning code with Semgrep $(SEMGREP_VERSION)..."; \
	config=""; \
	for candidate in .semgrep.yaml .semgrep.yml; do \
		if [ -f "$$candidate" ]; then config="$$candidate"; break; fi; \
	done; \
	if [ -n "$$config" ]; then \
		echo "ℹ️  Using $$config"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) $(SEMGREP_IMAGE) \
			semgrep scan --config="$$config" --metrics=off .; \
	else \
		echo "ℹ️  Using pre-defined rulesets"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) $(SEMGREP_IMAGE) \
			semgrep scan $(addprefix --config ,$(SEMGREP_CONFIGS)) --metrics=off .; \
	fi

# ============================================================================
# Combined Scans
# ============================================================================

.PHONY: sec/scan
sec/scan: sec/scan/trivy/fs sec/scan/trivy/config sec/scan/semgrep ## Full scan. Subcommands: sec/scan/[trivy/fs,trivy/config,trivy/artifact ARTIFACT=<path>,trivy/img IMAGE=<Docker img tag>,/semgrep,/clean,/help]. Databases: sec/db/[update,status,clean].
	@echo "✅ All scans complete"

# ============================================================================
# Maintenance
# ============================================================================

.PHONY: sec/scan/clean
sec/scan/clean: # Remove gh-security-toolkit image
	@echo "🧹 Cleaning gh-security-toolkit Docker image..."
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) stop 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) rm 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) rmi -f $(__GHST_IMAGE) 2>/dev/null || echo "ℹ️  Image $(__GHST_IMAGE) not found (already clean)"
	@rm -f "$(__GHST_IMAGE_STAMP)"
	@echo "✅ Docker cleanup complete. Next run will pull fresh image."

# ============================================================================
# Help
# ============================================================================

.PHONY: sec/scan/help
sec/scan/help: # Print help
	@echo "gh-security-toolkit commands (sec/ namespace):"
	@grep -hE '^sec/[a-zA-Z_/-]+:.*#' $(MAKEFILE_LIST) | \
	awk 'BEGIN {FS = ":[^#]*#+[ ]*"}; {printf "  \033[36m%-30s\033[0m %s\n", $$1, $$2}'
