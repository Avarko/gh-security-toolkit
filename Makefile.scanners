# ============================================================================
# Makefile.scanners
#
# Includable commands to your Makefiles
# All commands are namespaced under sec/ to avoid conflicts
# ============================================================================

__GHST_VERSION ?= main
__GHST_IMAGE ?= ghcr.io/avarko/gh-security-toolkit:$(__GHST_VERSION)
__GHST_DOCKER_CMD ?= docker
__GHST_PLATFORM ?=

# Auto-detect host platform in a Docker-compatible format
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_M),x86_64)
  __GHST_PLATFORM ?= linux/amd64
else ifeq ($(UNAME_M),arm64)
  __GHST_PLATFORM ?= linux/arm64
else ifeq ($(UNAME_M),aarch64)
  __GHST_PLATFORM ?= linux/arm64
else
  # Fallback (safe) – try native but allow override
  __GHST_PLATFORM ?= linux/$(UNAME_M)
endif

# Docker options: Mount only current directory (read-only option available)
__GHST_MOUNT_RO ?= true

# Docker socket GID for image scanning (auto-detected)
__DOCKER_SOCK_GID := $(shell stat -c '%g' /var/run/docker.sock 2>/dev/null || stat -f '%g' /var/run/docker.sock 2>/dev/null)

# ============================================================================
# Trivy vulnerability database cache
#
# The databases are no longer baked into the toolkit image: that cost ~2.8 GB
# of image and forced a full re-pull whenever they went stale. They now live in
# one cache directory shared by every project on this machine, updated
# incrementally — a developer who scanned recently fetches a delta of a few
# hundred kilobytes instead of ~1.4 GB.
#
# Scans still run air-gapped. Only sec/db/update touches the network, and only
# to fetch database updates.
# ============================================================================

__GHST_DB_CACHE ?= $(HOME)/.cache/gh-security-toolkit/trivy-db
__GHST_DB_REPO ?= ghcr.io/avarko/trivy-incremental-dbs

# Set GHST_OFFLINE=1 to skip the update check entirely and scan with whatever
# the cache already holds. Useful on a plane, behind a restrictive proxy, or
# when a scan must not depend on the network.
GHST_OFFLINE ?= 0

# Refuse to scan against a database older than this many days. Stale
# vulnerability data is worse than a failed scan, because it reports "clean"
# for vulnerabilities published since.
__GHST_DB_MAX_AGE_DAYS ?= 14

__GHST_DB_MOUNT := -v $(__GHST_DB_CACHE):/opt/trivy-cache:ro

# Mount Maven and Gradle caches if they exist
__M2_EXISTS        := $(shell [ -d "$$HOME/.m2/repository" ] && echo yes || echo no)
__GRADLE_EXISTS    := $(shell [ -d "$$HOME/.gradle/caches/modules-2" ] && echo yes || echo no)
__M2_MOUNT       := $(if $(filter yes,$(__M2_EXISTS)),-v $$HOME/.m2/repository:/home/ghst/.m2/repository:ro,)
__GRADLE_MOUNT   := $(if $(filter yes,$(__GRADLE_EXISTS)),-v $$HOME/.gradle/caches/modules-2:/home/ghst/.gradle/caches/modules-2:ro,)

# Network isolation: --network=none ensures air-gapped execution (no data leaves your machine)
ifeq ($(__GHST_MOUNT_RO),true)
	__GHST_DOCKER_OPTS := --rm --network=none \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	 -v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
else
	__GHST_DOCKER_OPTS := --rm --network=none \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v $(PWD):/workspace $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
endif

# Output format options
__GHST_TRIVY_FORMAT ?= table
__GHST_TRIVY_TIMEOUT ?= 5m

# ============================================================================
# Database management
# ============================================================================

# Database updates run inside the toolkit image, exactly like the scans do.
# Everything they need — the helper binary, crane, jq — ships in that image,
# so a developer installs nothing beyond Docker.
#
# Unlike the scan targets this one gets a network and a writable cache mount,
# because fetching updates is the one step that has to reach the registry.
__GHST_DB_RUN = $(__GHST_DOCKER_CMD) run --rm \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v $(__GHST_DB_CACHE):/db-cache \
	-e GHST_DB_CACHE=/db-cache \
	-e GHST_DB_REPO=$(__GHST_DB_REPO) \
	-e GHST_DB_MAX_AGE_DAYS=$(__GHST_DB_MAX_AGE_DAYS) \
	-e GHST_OFFLINE=$(GHST_OFFLINE) \
	$(__GHST_IMAGE) trivy-db-helper

# The cache directory must exist before Docker mounts it, or Docker creates it
# owned by root.
__GHST_DB_PREPARE = mkdir -p $(__GHST_DB_CACHE)

.PHONY: sec/db/update
sec/db/update: # Fetch Trivy database updates (incremental when possible)
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command update

.PHONY: sec/db/status
sec/db/status: # Show Trivy database cache location, age and versions
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command status

.PHONY: sec/db/clean
sec/db/clean: # Remove the cached Trivy databases
	@echo "🧹 Removing Trivy database cache..."
	@rm -rf $(__GHST_DB_CACHE)
	@echo "✅ Cache removed. The next scan downloads a fresh database."

# Scan targets depend on this: it updates a stale cache and is a no-op when the
# cache is current. GHST_OFFLINE=1 turns it into a freshness warning instead.
.PHONY: __ghst-db-ensure
__ghst-db-ensure:
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command ensure

# ============================================================================
# Trivy - Automatically uses .trivy.yaml if present
#
# Scans run with --network=none against a database mounted from the host
# cache, so no scan reaches the network. Only sec/db/update does.
#
# Gradle note: trivy fs . only works with lock files. For Gradle projects:
#   Option A: Generate lock files first:  ./gradlew dependencies --write-locks
#   Option B: Scan built artifacts:       make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war
# ============================================================================

.PHONY: sec/scan/trivy/fs
sec/scan/trivy/fs: __ghst-db-ensure # Scan filesystem (uses .trivy.yaml config)
	@echo "🔍 Scanning filesystem with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/artifact
sec/scan/trivy/artifact: __ghst-db-ensure # Scan built artifact - Gradle WAR/JAR/EAR (ARTIFACT=path/to/app.war)
	@[ -n "$(ARTIFACT)" ] || (echo "❌ Usage: make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war" && exit 1)
	@[ -e "$(ARTIFACT)" ] || (echo "❌ Artifact not found: $(ARTIFACT)" && exit 1)
	@echo "🔍 Scanning artifact $(ARTIFACT) with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs $(ARTIFACT) --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/config
sec/scan/trivy/config: __ghst-db-ensure # Scan IaC configs for misconfigurations - Terraform, Dockerfile, K8s, etc. (uses .trivy.yaml config)
	@echo "🔍 Scanning IaC configs with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy config . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/img
sec/scan/trivy/img: __ghst-db-ensure # Scan Docker image (IMAGE=name:tag)
	@[ -n "$(IMAGE)" ] || (echo "❌ Usage: make sec/scan/trivy/img IMAGE=name:tag" && exit 1)
	@echo "🔍 Scanning image $(IMAGE) (offline mode)..."
	@echo "ℹ️  Note: Docker socket access required (network isolation disabled for this scan)"
	$(__GHST_DOCKER_CMD) run --rm --network=none \
	$(if $(__DOCKER_SOCK_GID),--group-add $(__DOCKER_SOCK_GID),) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) -w /workspace \
	$(__GHST_IMAGE) trivy image $(IMAGE) --format $(__GHST_TRIVY_FORMAT)

# ============================================================================
# Semgrep - Automatically uses .semgrep.yaml if present
# ============================================================================

SEMGREP_IMAGE_TAG ?= latest
SEMGREP_DOCKER_OPTS := --rm -v $(PWD):/src:ro -w /src

.PHONY: sec/scan/semgrep
sec/scan/semgrep: # Scan code with Semgrep (uses .semgrep.yaml config)
	@echo "🔍 Scanning code with Semgrep..."
	@if [ -f .semgrep.yaml ] || [ -f .semgrep.yml ]; then \
		echo "ℹ️  Using .semgrep.yaml configuration"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) semgrep/semgrep:$(SEMGREP_IMAGE_TAG) \
			semgrep scan --config=.semgrep.yaml --metrics=off .; \
	else \
		echo "ℹ️  Using pre-defined rulesets"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) semgrep/semgrep:$(SEMGREP_IMAGE_TAG) \
			semgrep scan \
			--config p/owasp-top-ten \
			--config p/cwe-top-25 \
			--config p/java \
			--config p/javascript \
			--config p/docker-compose \
			--config p/dockerfile \
			--config p/terraform \
			--config p/secrets \
			--metrics=off \
			.; \
	fi

# ============================================================================
# Combined Scans
# ============================================================================

.PHONY: sec/scan
sec/scan: sec/scan/trivy/fs sec/scan/trivy/config sec/scan/semgrep ## Full scan. Subcommands: sec/scan/[trivy/fs,trivy/config,trivy/artifact ARTIFACT=<path>,trivy/img IMAGE=<Docker img tag>,/semgrep,/clean,/help]. Databases: sec/db/[update,status,clean].
	@echo "✅ All scans complete"

# ============================================================================
# Maintenance
# ============================================================================

.PHONY: sec/scan/clean
sec/scan/clean: # Remove gh-security-toolkit image
	@echo "🧹 Cleaning gh-security-toolkit Docker image..."
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) stop 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) rm 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) rmi -f $(__GHST_IMAGE) 2>/dev/null || echo "ℹ️  Image $(__GHST_IMAGE) not found (already clean)"
	@echo "✅ Docker cleanup complete. Next run will pull fresh image."

# ============================================================================
# Help
# ============================================================================

.PHONY: sec/scan/help
sec/scan/help: # Print help
	@echo "gh-security-toolkit commands (sec/ namespace):"
	@grep -E '^sec/[a-zA-Z_/-]+:.*?# .*$$' $(MAKEFILE_LIST) | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-30s\033[0m %s\n", $$1, $$2}'
