# ============================================================================
# Makefile.scanners
#
# Includable commands to your Makefiles
# All commands are namespaced under sec/ to avoid conflicts
# ============================================================================

__GHST_VERSION ?= main

# Image tag, which defaults to the makefile version but is separate on
# purpose: testing this makefile from a branch does not imply an image
# published under that branch's name. Set __GHST_IMAGE_TAG to point at a
# different image than the makefile came from.
__GHST_IMAGE_TAG ?= $(__GHST_VERSION)
__GHST_IMAGE ?= ghcr.io/avarko/gh-security-toolkit:$(__GHST_IMAGE_TAG)
__GHST_DOCKER_CMD ?= docker
__GHST_PLATFORM ?=

# Auto-detect host platform in a Docker-compatible format
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_M),x86_64)
  __GHST_PLATFORM ?= linux/amd64
else ifeq ($(UNAME_M),arm64)
  __GHST_PLATFORM ?= linux/arm64
else ifeq ($(UNAME_M),aarch64)
  __GHST_PLATFORM ?= linux/arm64
else
  # Fallback (safe) – try native but allow override
  __GHST_PLATFORM ?= linux/$(UNAME_M)
endif

# Docker options: Mount only current directory (read-only option available)
__GHST_MOUNT_RO ?= true

# Containers run as the invoking user so files they create in mounted
# directories stay owned by the developer, and so they can read a cache the
# developer owns. See the database section for why this is not optional.
__GHST_HOST_UID := $(shell id -u)
__GHST_HOST_GID := $(shell id -g)

# Docker socket GID for image scanning (auto-detected)
__DOCKER_SOCK_GID := $(shell stat -c '%g' /var/run/docker.sock 2>/dev/null || stat -f '%g' /var/run/docker.sock 2>/dev/null)

# ============================================================================
# Trivy vulnerability database cache
#
# The databases are no longer baked into the toolkit image: that cost ~2.8 GB
# of image and forced a full re-pull whenever they went stale. They now live in
# one cache directory shared by every project on this machine, updated
# incrementally — a developer who scanned recently fetches a delta of a few
# hundred kilobytes instead of ~1.4 GB.
#
# Scans still run air-gapped. Only sec/db/update touches the network, and only
# to fetch database updates.
# ============================================================================

__GHST_DB_CACHE ?= $(HOME)/.cache/gh-security-toolkit/trivy-db
__GHST_DB_REPO ?= ghcr.io/avarko/trivy-incremental-dbs

# Set GHST_OFFLINE=1 to skip the update check entirely and scan with whatever
# the cache already holds. Useful on a plane, behind a restrictive proxy, or
# when a scan must not depend on the network.
GHST_OFFLINE ?= 0

# Database artifacts are signed by the publishing workflow and verified before
# they are unpacked. A database that cannot be traced back to that workflow is
# not used: it decides what every scan reports, and a substituted one reports
# clean rather than looking wrong.
#
# Set to 0 only to update across the boundary where signing was introduced,
# since artifacts published before it carry no signature.
GHST_DB_REQUIRE_SIGNATURE ?= 1

# Refuse to scan against a database older than this many days. Stale
# vulnerability data is worse than a failed scan, because it reports "clean"
# for vulnerabilities published since.
__GHST_DB_MAX_AGE_DAYS ?= 14

# Set GHST_DB_DEBUG=1 to make the update trace itself: every registry command
# it runs, and crane's own HTTP request and response logs. Reach for it when
# an update fails for a reason the error does not name — a proxy that
# intercepts TLS, a blocked host, a token endpoint that answers differently
# than the pull does. The trace goes to stderr, so piping stdout still works.
GHST_DB_DEBUG ?= 0

# The cache is mounted read-only so a scan cannot corrupt it, but Trivy also
# wants somewhere writable for its own scratch state (fanal/, temp files). A
# tmpfs gives it that without a second host directory, and it is discarded
# when the container exits.
__GHST_DB_MOUNT := -v $(__GHST_DB_CACHE)/db:/opt/trivy-cache/db:ro \
	-v $(__GHST_DB_CACHE)/java-db:/opt/trivy-cache/java-db:ro \
	--tmpfs /opt/trivy-cache/fanal:rw,size=512m

# Mount Maven and Gradle caches if they exist
__M2_EXISTS        := $(shell [ -d "$$HOME/.m2/repository" ] && echo yes || echo no)
__GRADLE_EXISTS    := $(shell [ -d "$$HOME/.gradle/caches/modules-2" ] && echo yes || echo no)
__M2_MOUNT       := $(if $(filter yes,$(__M2_EXISTS)),-v $$HOME/.m2/repository:/home/ghst/.m2/repository:ro,)
__GRADLE_MOUNT   := $(if $(filter yes,$(__GRADLE_EXISTS)),-v $$HOME/.gradle/caches/modules-2:/home/ghst/.gradle/caches/modules-2:ro,)

# Scans run as the invoking user for the same reason the update does: the
# database cache is the developer's, and the image's own account cannot read
# it. Trivy also wants a writable HOME for its scratch state, which /tmp
# provides without touching the workspace.
__GHST_USER_OPTS := --user $(__GHST_HOST_UID):$(__GHST_HOST_GID) -e HOME=/tmp

# Network isolation: --network=none ensures air-gapped execution (no data leaves your machine)
ifeq ($(__GHST_MOUNT_RO),true)
	__GHST_DOCKER_OPTS := --rm --network=none $(__GHST_USER_OPTS) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	 -v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
else
	__GHST_DOCKER_OPTS := --rm --network=none $(__GHST_USER_OPTS) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v $(PWD):/workspace $(__GHST_DB_MOUNT) $(__M2_MOUNT) $(__GRADLE_MOUNT) -w /workspace
endif

# Output format options
__GHST_TRIVY_FORMAT ?= table
__GHST_TRIVY_TIMEOUT ?= 5m

# ============================================================================
# Database management
# ============================================================================

# Database updates run inside the toolkit image, exactly like the scans do.
# Everything they need — the helper binary, crane, jq — ships in that image,
# so a developer installs nothing beyond Docker.
#
# Unlike the scan targets this one gets a network and a writable cache mount,
# because fetching updates is the one step that has to reach the registry.
#
# It also runs as the invoking user rather than the image's own account.
#
# Writing goes through the bind mount, but a bind mount is not a copy: it is
# the host's own directory, and the host kernel checks permissions against the
# host inode. The image's ghst account is uid 10001 while the cache belongs to
# the developer, so creating files there is denied — and were the directory
# world-writable it would be worse, since the files would end up owned by
# 10001 and `sec/db/clean` could not remove them without sudo.
#
# Docker Desktop on macOS remaps ownership and hides this; Linux does not.
__GHST_DB_RUN = $(__GHST_DOCKER_CMD) run --rm \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	--user $(__GHST_HOST_UID):$(__GHST_HOST_GID) \
	-v $(__GHST_DB_CACHE):/db-cache \
	-e GHST_DB_CACHE=/db-cache \
	-e HOME=/tmp \
	-e GHST_DB_REPO=$(__GHST_DB_REPO) \
	-e GHST_DB_MAX_AGE_DAYS=$(__GHST_DB_MAX_AGE_DAYS) \
	-e GHST_DB_REQUIRE_SIGNATURE=$(GHST_DB_REQUIRE_SIGNATURE) \
	-e GHST_OFFLINE=$(GHST_OFFLINE) \
	-e GHST_DB_DEBUG=$(GHST_DB_DEBUG) \
	-e GHST_VEX_SERVE=0 \
	$(__GHST_IMAGE) trivy-db-helper

# The cache directory must exist before Docker mounts it, or Docker creates it
# owned by root.
__GHST_DB_PREPARE = mkdir -p $(__GHST_DB_CACHE)

.PHONY: sec/db/update
sec/db/update: __ghst-image-ensure # Fetch Trivy database updates (incremental when possible)
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command update

.PHONY: sec/db/status
sec/db/status: __ghst-image-ensure # Show Trivy database cache location, age and versions
	@$(__GHST_DB_PREPARE)
	@echo "Trivy database cache: $(__GHST_DB_CACHE)"
	@# The helper reports the path it sees inside the container, which is not
	@# where the developer would go looking; the host path is printed above.
	@$(__GHST_DB_RUN) -command status | grep -v '^Trivy database cache:'

.PHONY: sec/db/clean
sec/db/clean: # Remove the cached Trivy databases
	@echo "🧹 Removing Trivy database cache..."
	@rm -rf $(__GHST_DB_CACHE)
	@echo "✅ Cache removed. The next scan downloads a fresh database."

# Scan targets depend on this: it updates a stale cache and is a no-op when the
# cache is current. GHST_OFFLINE=1 turns it into a freshness warning instead.
.PHONY: __ghst-db-ensure
__ghst-db-ensure: __ghst-image-ensure
	@$(__GHST_DB_PREPARE)
	@$(__GHST_DB_RUN) -command ensure

# ============================================================================
# Toolkit image freshness
#
# Docker only pulls a tag when it has nothing local by that name, so an image
# pulled once is never revisited — a fixed bug or a new helper version sits in
# the registry indefinitely while every scan keeps running the old one. That
# is exactly how a database-format change once shipped to the registry days
# before any developer's local image could read it.
#
# Checked once per __GHST_IMAGE_MAX_AGE_DAYS rather than every invocation, so
# an otherwise offline scan does not pay a registry round-trip each time. Same
# shape as __GHST_DB_MAX_AGE_DAYS above, and for the same reason: a stale tool
# should be refreshed on a schedule, not left to a developer noticing.
# ============================================================================

__GHST_IMAGE_MAX_AGE_DAYS ?= 1
__GHST_IMAGE_STAMP := $(HOME)/.cache/gh-security-toolkit/.image-checked-$(subst /,_,$(__GHST_IMAGE_TAG))

.PHONY: __ghst-image-ensure
__ghst-image-ensure:
	@mkdir -p "$(dir $(__GHST_IMAGE_STAMP))"
	@if [ "$(GHST_OFFLINE)" = "1" ]; then exit 0; fi; \
	if $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) >/dev/null 2>&1 \
	   && [ -f "$(__GHST_IMAGE_STAMP)" ]; then \
		now=$$(date +%s); \
		checked=$$(stat -c %Y "$(__GHST_IMAGE_STAMP)" 2>/dev/null || stat -f %m "$(__GHST_IMAGE_STAMP)"); \
		age_days=$$(( (now - checked) / 86400 )); \
		[ "$$age_days" -lt "$(__GHST_IMAGE_MAX_AGE_DAYS)" ] && exit 0; \
	fi; \
	echo "🔄 Checking for a newer $(__GHST_IMAGE)..."; \
	if $(__GHST_DOCKER_CMD) pull -q $(__GHST_IMAGE) >/dev/null 2>&1; then \
		touch "$(__GHST_IMAGE_STAMP)"; \
	elif $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) >/dev/null 2>&1; then \
		echo "⚠️  Could not reach the registry — using the cached image."; \
		touch "$(__GHST_IMAGE_STAMP)"; \
	else \
		echo "❌ $(__GHST_IMAGE) is not available locally and the registry could not be reached."; \
		exit 1; \
	fi

# ============================================================================
# Provenance
#
# Every scan states what produced it, naming both sources by their repository:
# the scanner image from gh-security-toolkit, and the vulnerability data from
# trivy-incremental-dbs. Each line carries a publication date as well as a
# digest or version, because a date is what a reader can judge at a glance and
# a hash is what they need when they have to reproduce the run.
#
# This exists because a scan result is only worth something if it can be
# reproduced, and until now nothing in the output said what it ran. A tag is
# not an answer: `main` moved twice this week, and two developers scanning the
# same code on the same day could get different findings with no way to tell.
#
# The image half is read from the local image, so it costs nothing and works
# offline. The database half asks the helper inside that image, which is one
# short container run against a cache that is already mounted. Asking the
# helper rather than parsing the cache directly means this works with the
# helper that is published today, not only with one built after this change.
#
# Output goes to stderr, so it cannot land in a report redirected to a file.
# Note that the scan targets' own progress echoes still go to stdout, so
# `__GHST_TRIVY_FORMAT=json > report.json` is not clean today for reasons that
# predate this banner.
# ============================================================================

# Docker's template language has no "or" for missing map keys, so each value
# is fetched with `with`, which prints nothing when the label is absent.
__GHST_LABEL = $(__GHST_DOCKER_CMD) image inspect $(__GHST_IMAGE) \
	--format '{{with index .Config.Labels "$(1)"}}{{.}}{{end}}' 2>/dev/null

.PHONY: sec/provenance
sec/provenance: ## Print what a scan on this machine would run: images, dates, digests, versions
	@$(MAKE) --no-print-directory __ghst-provenance GHST_PROVENANCE_VERBOSE=1

# Printed before every scan. Silent about anything it cannot determine rather
# than guessing: "unknown" is better than a plausible wrong answer.
.PHONY: __ghst-provenance
__ghst-provenance: __ghst-db-ensure
	@ref='$(__GHST_IMAGE)'; \
	if ! $(__GHST_DOCKER_CMD) image inspect $$ref >/dev/null 2>&1; then \
		echo "==> gh-security-toolkit: $$ref is not present locally yet" >&2; \
	else \
		digest=$$($(__GHST_DOCKER_CMD) image inspect $$ref \
			--format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' 2>/dev/null \
			| sed 's/.*@//'); \
		revision=$$($(call __GHST_LABEL,org.opencontainers.image.revision)); \
		built=$$($(call __GHST_LABEL,org.opencontainers.image.created)); \
		if [ -z "$$built" ]; then \
			built=$$($(__GHST_DOCKER_CMD) image inspect $$ref --format '{{.Created}}' 2>/dev/null); \
		fi; \
		built=$$(echo "$$built" | cut -c1-10); \
		echo "==> gh-security-toolkit: image '$(__GHST_IMAGE_TAG)' published $${built:-unknown}, digest $$(echo $${digest:-unknown} | cut -c1-19), revision $$(echo $${revision:-unknown} | cut -c1-12)" >&2; \
		if [ "$(GHST_PROVENANCE_VERBOSE)" = "1" ]; then \
			trivy_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trivy.version)); \
			th_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trufflehog.version)); \
			helper_ver=$$($(call __GHST_LABEL,fi.evolver.ghst.trivy-db-helper.version)); \
			echo "    digest      $${digest:-unknown}" >&2; \
			echo "    revision    $${revision:-unknown}" >&2; \
			echo "    trivy       $${trivy_ver:-unknown}" >&2; \
			echo "    trufflehog  $${th_ver:-unknown}" >&2; \
			echo "    db helper   $${helper_ver:-unknown}" >&2; \
			echo "    makefile    taken from '$(__GHST_VERSION)', image tag '$(__GHST_IMAGE_TAG)'" >&2; \
		fi; \
		if [ -z "$$digest" ]; then \
			echo "    note: no registry digest. This image was built or loaded locally, so no" >&2; \
			echo "          published image corresponds to this scan." >&2; \
		fi; \
		if [ -z "$$revision" ]; then \
			echo "    note: no revision label, so the commit behind this scan is unknown." >&2; \
			echo "          Pull the image again once a labelled one is published." >&2; \
		fi; \
	fi; \
	$(__GHST_DB_PREPARE); \
	status=$$($(__GHST_DB_RUN) -command status 2>/dev/null); \
	echo "==> trivy-incremental-dbs: $$(echo "$$status" | $(__GHST_AWK_DB_VERSIONS))" >&2; \
	if [ "$(GHST_PROVENANCE_VERBOSE)" = "1" ]; then \
		echo "$$status" | sed 's/^/    /' >&2; \
	fi; \
	if [ "$(__GHST_VERSION)" != "$(__GHST_IMAGE_TAG)" ]; then \
		echo "    note: Makefile pinned to '$(__GHST_VERSION)', image tag '$(__GHST_IMAGE_TAG)'." >&2; \
		echo "          Pinning the include does not pin the scanner." >&2; \
	fi

# Reduces the helper's status report to one line: each database with the date
# it was published, how long ago this machine fetched it, and which helper
# assembled it.
#
# The version each database carries is a publication date in YYYYMMDD form,
# which is why it can be rendered as one. Anything the helper did not report
# comes out as "unknown" rather than being dropped, so a partial line cannot
# read as a complete one.
__GHST_AWK_DB_VERSIONS = awk ' \
	/^  (main|java):/ { \
		name = $$1; sub(":", "", name); \
		v = $$2; \
		if (v ~ /^[0-9]{8}$$/) \
			v = substr(v,1,4) "-" substr(v,5,2) "-" substr(v,7,2); \
		out = out (out ? ", " : "") name " " v; \
	} \
	/^  age:/    { age = $$2 } \
	/^  helper:/ { helper = $$3 } \
	END { \
		printf "%s", (out ? out : "no database cached"); \
		printf ", fetched %s day(s) ago", (age == "" ? "?" : age); \
		printf ", helper %s", (helper ? helper : "unknown"); \
	}'

# ============================================================================
# Trivy - Automatically uses .trivy.yaml if present
#
# Scans run with --network=none against a database mounted from the host
# cache, so no scan reaches the network. Only sec/db/update does.
#
# Gradle note: trivy fs . only works with lock files. For Gradle projects:
#   Option A: Generate lock files first:  ./gradlew dependencies --write-locks
#   Option B: Scan built artifacts:       make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war
# ============================================================================

.PHONY: sec/scan/trivy/fs
sec/scan/trivy/fs: __ghst-provenance # Scan filesystem (uses .trivy.yaml config)
	@echo "🔍 Scanning filesystem with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/artifact
sec/scan/trivy/artifact: __ghst-provenance # Scan built artifact - Gradle WAR/JAR/EAR (ARTIFACT=path/to/app.war)
	@[ -n "$(ARTIFACT)" ] || (echo "❌ Usage: make sec/scan/trivy/artifact ARTIFACT=build/libs/app.war" && exit 1)
	@[ -e "$(ARTIFACT)" ] || (echo "❌ Artifact not found: $(ARTIFACT)" && exit 1)
	@echo "🔍 Scanning artifact $(ARTIFACT) with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy fs $(ARTIFACT) --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/config
sec/scan/trivy/config: __ghst-provenance # Scan IaC configs for misconfigurations - Terraform, Dockerfile, K8s, etc. (uses .trivy.yaml config)
	@echo "🔍 Scanning IaC configs with Trivy (offline mode)..."
	@test -f .trivy.yaml && echo "ℹ️  Using .trivy.yaml configuration" || true
	$(__GHST_DOCKER_CMD) run $(__GHST_DOCKER_OPTS) \
	$(__GHST_IMAGE) trivy config . --format $(__GHST_TRIVY_FORMAT) --timeout $(__GHST_TRIVY_TIMEOUT)

.PHONY: sec/scan/trivy/img
sec/scan/trivy/img: __ghst-provenance # Scan Docker image (IMAGE=name:tag)
	@[ -n "$(IMAGE)" ] || (echo "❌ Usage: make sec/scan/trivy/img IMAGE=name:tag" && exit 1)
	@echo "🔍 Scanning image $(IMAGE) (offline mode)..."
	@echo "ℹ️  Note: this target mounts the Docker socket so Trivy can read the"
	@echo "   image. That is root-equivalent access to this host, and this is the"
	@echo "   only target that needs it. The scan itself still runs with"
	@echo "   --network=none, like every other scan."
	$(__GHST_DOCKER_CMD) run --rm --network=none \
	$(if $(__DOCKER_SOCK_GID),--group-add $(__DOCKER_SOCK_GID),) \
	$(if $(__GHST_PLATFORM),--platform=$(__GHST_PLATFORM),) \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v $(PWD):/workspace:ro $(__GHST_DB_MOUNT) -w /workspace \
	$(__GHST_IMAGE) trivy image $(IMAGE) --format $(__GHST_TRIVY_FORMAT)

# ============================================================================
# Semgrep - Automatically uses .semgrep.yaml if present
# ============================================================================

SEMGREP_IMAGE_TAG ?= latest
SEMGREP_DOCKER_OPTS := --rm -v $(PWD):/src:ro -w /src

.PHONY: sec/scan/semgrep
sec/scan/semgrep: # Scan code with Semgrep (uses .semgrep.yaml config)
	@echo "🔍 Scanning code with Semgrep..."
	@if [ -f .semgrep.yaml ] || [ -f .semgrep.yml ]; then \
		echo "ℹ️  Using .semgrep.yaml configuration"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) semgrep/semgrep:$(SEMGREP_IMAGE_TAG) \
			semgrep scan --config=.semgrep.yaml --metrics=off .; \
	else \
		echo "ℹ️  Using pre-defined rulesets"; \
		$(__GHST_DOCKER_CMD) run $(SEMGREP_DOCKER_OPTS) semgrep/semgrep:$(SEMGREP_IMAGE_TAG) \
			semgrep scan \
			--config p/owasp-top-ten \
			--config p/cwe-top-25 \
			--config p/java \
			--config p/javascript \
			--config p/docker-compose \
			--config p/dockerfile \
			--config p/terraform \
			--config p/secrets \
			--metrics=off \
			.; \
	fi

# ============================================================================
# Combined Scans
# ============================================================================

.PHONY: sec/scan
sec/scan: sec/scan/trivy/fs sec/scan/trivy/config sec/scan/semgrep ## Full scan. Subcommands: sec/scan/[trivy/fs,trivy/config,trivy/artifact ARTIFACT=<path>,trivy/img IMAGE=<Docker img tag>,/semgrep,/clean,/help]. Databases: sec/db/[update,status,clean].
	@echo "✅ All scans complete"

# ============================================================================
# Maintenance
# ============================================================================

.PHONY: sec/scan/clean
sec/scan/clean: # Remove gh-security-toolkit image
	@echo "🧹 Cleaning gh-security-toolkit Docker image..."
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) stop 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) ps -a -q --filter "ancestor=$(__GHST_IMAGE)" | xargs -r $(__GHST_DOCKER_CMD) rm 2>/dev/null || true
	@$(__GHST_DOCKER_CMD) rmi -f $(__GHST_IMAGE) 2>/dev/null || echo "ℹ️  Image $(__GHST_IMAGE) not found (already clean)"
	@rm -f "$(__GHST_IMAGE_STAMP)"
	@echo "✅ Docker cleanup complete. Next run will pull fresh image."

# ============================================================================
# Help
# ============================================================================

.PHONY: sec/scan/help
sec/scan/help: # Print help
	@echo "gh-security-toolkit commands (sec/ namespace):"
	@grep -E '^sec/[a-zA-Z_/-]+:.*?# .*$$' $(MAKEFILE_LIST) | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-30s\033[0m %s\n", $$1, $$2}'
